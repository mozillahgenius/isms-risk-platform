<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.example.isms-platform.web-session-rotate</string>
	<key>ProgramArguments</key>
	<array>
		<string>python3</string>
		<string>/opt/isms-platform/scripts/rotate_web_session.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>21600</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ThrottleInterval</key>
	<integer>300</integer>
	<key>StandardOutPath</key>
	<string>/var/log/isms-platform/web-session-rotate.out.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/isms-platform/web-session-rotate.err.log</string>
</dict>
</plist>
