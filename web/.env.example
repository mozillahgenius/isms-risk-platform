# Example server-side configuration for the web app (copy to web/.env.local).
# Never commit real values. Every variable is optional unless noted; features whose
# settings are missing stay disabled (fail-closed) instead of guessing.

# --- Database connections -----------------------------------------------------
# Read-only connection used by the catalog / dashboard pages (role app_ro).
ISMS_WEB_DATABASE_URL=postgres:///isms_dev?user=app_ro
# Write connection for forms (role app_rw). Leave empty to keep the UI read-only.
ISMS_WRITE_DATABASE_URL=
# Connection used by the endpoint agent ingestion API (role app_rw).
ISMS_AGENT_DATABASE_URL=
# Connection for the trusted-proxy identity binding (role management_web).
ISMS_PROXY_DATABASE_URL=

# --- Tenant session -----------------------------------------------------------
# Server-only tenant session token printed by `make tenant`.
ISMS_WEB_TENANT_TOKEN=
# Non-production only: allow writes attributed to the shared-token user.
ISMS_WEB_ALLOW_SHARED_WRITE_ACTOR=
# Enable the connector settings form (1 = enabled).
ISMS_SETTINGS_WRITE_ENABLED=
ISMS_WEB_BASE_URL=

# --- Reverse proxy / SSO ------------------------------------------------------
# Shared secret that only the reverse proxy sends in x-isms-device-control-proxy-secret
# (at least 16 characters).
ISMS_DEVICE_CONTROL_PROXY_SECRET=
# Public origins allowed for Server Actions behind a proxy (comma separated, e.g. isms.example.com).
ISMS_SERVER_ACTIONS_ALLOWED_ORIGINS=

# --- Device control (optional, external dispatch orchestrator) ------------------
ISMS_DEVICE_DISPATCH_URL=
ISMS_DEVICE_DISPATCH_TOKEN=
ISMS_DEVICE_DISPATCH_VIEW_TOKEN=
# Comma separated e-mail allowlists (execute / view).
ISMS_DEVICE_CONTROL_ALLOWED_EMAILS=
ISMS_DEVICE_CONTROL_VIEW_ALLOWED_EMAILS=
# JSON array of devices that may be targeted, e.g.
# [{"key":"<dispatcher device id>","label":"Example laptop"}]
# Empty = no device can be selected.
ISMS_DEVICE_CONTROL_DEVICES=

# --- Connector hub (optional) -------------------------------------------------
# HTTPS URL of the external connector hub's settings page.
ISMS_CONNECTOR_HUB_URL=

# --- Endpoint agent -----------------------------------------------------------
ISMS_AGENT_INGEST_SECRET=
ISMS_AGENT_DEFINITION_PRIVATE_KEY_B64=

# --- Verification receipts ----------------------------------------------------
ISMS_VERIFICATION_RECEIPT_TOKEN=

# --- Management internal API (see docs/internal-management-api.md) ------------
ISMS_MANAGEMENT_S2S_TOKEN=
ISMS_MANAGEMENT_TENANT_ID=
ISMS_MANAGEMENT_ACTOR_ID=
ISMS_MANAGEMENT_SESSION_TOKEN=

# --- e-learning completion sync (optional) ------------------------------------
ELEARNING_COMPLETIONS_URL=
ELEARNING_MANAGEMENT_SYNC_TOKEN=

# --- Password manager status (optional, Bitwarden-compatible server) ------------
PASSWORD_MANAGER_PROVIDER=
PASSWORD_MANAGER_PRODUCT=
PASSWORD_MANAGER_URL=
PASSWORD_MANAGER_HEALTH_PATH=
PASSWORD_MANAGER_STATUS_FILE=

# --- Identity provisioning (optional) -----------------------------------------
IDENTITY_PROVISIONING_PROVIDER=
IDENTITY_PROVISIONING_DISPATCH_URL=
IDENTITY_PROVISIONING_DISPATCH_TOKEN=
